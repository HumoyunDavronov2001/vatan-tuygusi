# VATAN TUYG'USI — mahalliy ishga tushirish uchun muhit o'zgaruvchilari.
# Nusxalab ishlating: cp .env.example .env && set -a && . ./.env && set +a

# Tahlil usuli: qoida — modelsiz (standart, API kerak emas) | claude — tashqi LLM API (kalit va kredit kerak)
VATAN_BACKEND=qoida
# Faqat VATAN_BACKEND=claude bo'lsa
ANTHROPIC_API_KEY=
VATAN_MODEL=claude-opus-5

# Seansdagi video soni (oraliq) va portret uchun minimal muvaffaqiyatli video
VATAN_VIDEO_MIN=3
VATAN_VIDEO_MAX=5
VATAN_MIN_PORTRET=3

# Kadrlar soni va uzun tomoni (piksel)
VATAN_KADR_SONI=8
VATAN_KADR_ULCHAM=896

# Whisper modeli: tiny | base | small | medium | large-v3; til bo'sh bo'lsa avtomatik
VATAN_WHISPER_MODEL=small
VATAN_WHISPER_TIL=uz

# Instagram login talab qilsa (ikkitasidan BITTASI)
# VATAN_IG_COOKIES=/yo'l/cookies.txt
# VATAN_IG_COOKIES_BRAUZER=firefox

# Server
VATAN_HOST=127.0.0.1
VATAN_PORT=5057

# Chegaralar
VATAN_MAX_DAVOMIYLIK=600
VATAN_MAX_HAJM_MB=200
VATAN_PARALLEL=2
