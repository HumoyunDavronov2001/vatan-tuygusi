# ──────────────────────────────────────────────────────────────────────────
#  Bu faylni `.env` nomi bilan nusxalang va to'ldiring.
#  `.env` HECH QACHON git ga tushmasin va chatga yozilmasin.
#
#      cp .env.example .env && nano .env
# ──────────────────────────────────────────────────────────────────────────

# ═══ TAHLIL VOSITASI ═══
# qoida  -> APIsiz, mahalliy (kalit so'z lug'ati + kadr rang tahlili).
#           Hech qanday tashqi xizmatga ulanmaydi, PUL KETMAYDI. STANDART.
# claude -> Anthropic API (sifatliroq, ammo kredit kerak).
VATAN_BACKEND=qoida

# Anthropic API kaliti — FAQAT VATAN_BACKEND=claude bo'lsa kerak.
# "qoida" backend'da bo'sh qoldiring.
ANTHROPIC_API_KEY=

# ═══ DOMENLAR ═══
VATAN_FRONT_DOMEN=vatan.example.uz
VATAN_API_DOMEN=vatanapi.example.uz

# Brauzer CORS uchun. Front domeni bilan AYNAN mos bo'lsin (https, oxirida / siz).
VATAN_FRONT_ORIGIN=https://vatan.example.uz

# ═══ MAVJUD CADDY BILAN BOG'LANISH ═══
# Serverda allaqachon Caddy ishlayapti (80/443 unda). Biz o'z Caddy'mizni
# ko'tarmaymiz — uning tarmog'iga qo'shilamiz va Caddyfile'ga blok qo'shamiz.
#
# Bu uchtasini `ornat.sh` AVTOMATIK aniqlaydi. Faqat aniqlay olmasa
# yoki noto'g'ri topsa qo'lda yozing:
#
# CADDY_KONTEYNER=caddy
# CADDY_TARMOQ=caddy_default
# CADDY_FAYL=/opt/caddy/Caddyfile
#
# Tekshirish uchun serverda:
#   docker ps --format '{{.Names}}\t{{.Image}}' | grep -i caddy
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' caddy
#   docker inspect -f '{{range .Mounts}}{{if eq .Destination "/etc/caddy/Caddyfile"}}{{.Source}}{{end}}{{end}}' caddy

# ═══ TAHLIL SOZLAMALARI ═══
VATAN_MODEL=claude-opus-5
VATAN_VIDEO_MIN=3
VATAN_VIDEO_MAX=5
VATAN_MIN_PORTRET=3
VATAN_KADR_SONI=8
VATAN_KADR_ULCHAM=896

# Whisper modeli. DIQQAT: image quriladigan paytda ham ishlatiladi.
# O'zgartirsangiz:  docker compose build --no-cache api
#   tiny (~75 MB) | base | small (~500 MB) | medium (~1.5 GB) | large-v3 (~3 GB)
VATAN_WHISPER_MODEL=small
VATAN_WHISPER_TIL=uz

# Bir vaqtda nechta video ishlanadi. Har biri ~1 yadro va ~1 GB RAM oladi.
# SERVERDA BOSHQA DASTURLAR BOR — 2 dan oshirmang.
VATAN_PARALLEL=2

VATAN_MAX_SEANS=50

# ═══ RESURS CHEGARASI ═══
# Boshqa dasturlar (boshqa loyihalar) protsessorsiz qolmasin.
VATAN_CPU_LIMIT=1.5
VATAN_RAM_LIMIT=2500m

# ═══ IXTIYORIY ═══

# Instagram cookies — ODATDA SHART EMAS (ochiq postlar cookies'siz ochiladi).
# Faqat yopiq profillar yoki Instagram IP cheklovi holatida kerak bo'ladi.
# Faylni `deploy/secrets/cookies.txt` ga qo'ying va izohdan chiqaring:
# VATAN_IG_COOKIES=/secrets/cookies.txt

# `/sinov` marshrutini yoqadi (pulli Claude chaqiruvi, ~$0.01).
# Bo'sh qoldirilsa marshrut butunlay o'chiq.
VATAN_SINOV_KALIT=
